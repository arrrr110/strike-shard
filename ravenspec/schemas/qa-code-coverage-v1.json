{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven.netease.com/schemas/qa-code-coverage-v1.json",
  "title": "Normalized QA Code Coverage v1",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "sourceFormat", "coverage", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "qa-code-coverage/v1" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceFormat": {
      "enum": ["go-coverprofile", "jacoco-xml", "xccov-json", "istanbul-json", "harmony-json"]
    },
    "coverage": {
      "type": "object",
      "required": ["lines", "branches", "functions", "statements", "changedLines", "mutation"],
      "additionalProperties": false,
      "properties": {
        "lines": { "$ref": "#/definitions/metric" },
        "branches": { "$ref": "#/definitions/metric" },
        "functions": { "$ref": "#/definitions/metric" },
        "statements": { "$ref": "#/definitions/metric" },
        "changedLines": { "$ref": "#/definitions/metric" },
        "mutation": { "$ref": "#/definitions/metric" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    }
  },
  "definitions": {
    "metric": {
      "type": "object",
      "required": ["covered", "total", "pct", "status"],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "status": { "enum": ["COLLECTED", "NOT_COLLECTED", "INVALID"] },
        "reason": { "type": "string" }
      },
      "if": {
        "properties": { "status": { "const": "INVALID" } }
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "pct": { "type": "null" },
          "reason": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["path", "sha256", "format"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)[\\s\\S]+$"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "format": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*\\u0000)(?=[\\s\\S]*\\S)[\\s\\S]+$"
        }
      }
    }
  }
}
