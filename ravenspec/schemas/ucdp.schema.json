{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ucdp-e2e-v1.json",
  "name": "ucdp_e2e_M{xxx}.json per-module schema (v1)",
  "type": "object",
  "required": ["_meta", "module", "cases"],
  "additionalProperties": false,
  "properties": {
    "_provenance": {
      "type": "object",
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "tool_version": {
          "type": "string"
        },
        "run_id": {
          "type": ["string", "null"]
        },
        "written_at": {
          "type": "string"
        }
      }
    },
    "_meta": {
      "type": "object",
      "required": ["moduleId"],
      "additionalProperties": false,
      "properties": {
        "moduleId": {
          "type": "string",
          "pattern": "^M[0-9]{3,}$"
        },
        "module_name": {
          "type": "string",
          "minLength": 1
        },
        "bizName": {
          "type": "string"
        },
        "issueKey": {
          "type": "string"
        },
        "spec_id": {
          "type": ["string", "null"]
        },
        "layer": {
          "type": ["string", "null"],
          "enum": ["L1", "L2", "L3", "L4", null]
        },
        "split_from": {
          "type": ["string", "null"]
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "source": {
          "type": ["string", "null"]
        },
        "generated_at": {
          "type": ["string", "null"]
        },
        "collapsed_count": {
          "type": "integer",
          "minimum": 0
        },
        "verdict_count": {
          "type": "integer",
          "minimum": 0
        },
        "skipped_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "module": {
      "type": "string",
      "description": "Display label, typically 'M{xxx}-{name}'",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "feature_id",
          "priority",
          "tags",
          "case_info",
          "user_profile",
          "defect_hypothesis",
          "pre_steps",
          "steps",
          "assertions",
          "cleanup",
          "_lineage"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(L1|TC|E2E|TM)-M[0-9]{3,}-[0-9]{3,}$",
            "description": "Format: {prefix}-{moduleId}-{caseSeq:03d}, prefix ∈ {L1, TC, E2E, TM}"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "feature_id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+){1,4}$",
            "description": "功能级稳定标识 (L3 检索键)。kebab-case, 2-5 token, ≤40 字符, 描述功能非测试点。同 change 内同 feature 必同 slug。AI 在 enrich 阶段从 module_name + scenario + PRD 功能章节抽取。示例: module='翻倍弹窗关闭逻辑隔离' → feature_id='yunbei-drawer-double-modal'。下游 mock_capability_gate.py emit_payload 按 feature_id 聚合产上报 payload features[]。"
          },
          "case_group": {
            "type": ["string", "null"],
            "description": "同类用例分组标识。同属一类的多条独立 case（如同一字段的边界变体、同一能力的权限用例对）填相同可读 slug，如 \"帖子数量-边界保护\" / \"相册权限\"；无分类填 null 或省略。"
          },
          "parent_id": {
            "type": ["string", "null"],
            "pattern": "^(L1|TC|E2E|TM)-M[0-9]{3,}-[0-9]{3,}$",
            "description": "数据维度扩展父用例 id。非空 = 本 case 是 parent_id 所指用例的数据变体子用例（由 mock_file_gen.py 衍生，同 api_path 不同 mock body）；null/省略 = 独立用例。子用例 case_group 应留空避免 gate enum-ladder 收敛误杀。"
          },
          "mock_variation": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["field", "value"],
            "description": "数据维度子用例的变异轴。非空 = 本 case 变化了 field 字段到 value（替代 name 后缀解析）。purpose 从父 mock_intent.api_refs[].key_fields 按 field 查,不在此重复存储。combo 组合用 field 哨兵 '<combo>',value 为 {fields:{...}},description 必填说明测试场景。",
            "properties": {
              "api_path": {
                "type": "string",
                "minLength": 1,
                "description": "变体唯一作用的接口路径；缺失时兼容旧数据并回退父用例首个接口"
              },
              "field": {
                "type": "string",
                "minLength": 1,
                "description": "变异字段 jsonpath,如 data.limit；combo 组合用哨兵 '<combo>'"
              },
              "value": {
                "description": "单字段变异值(任意类型)；combo 时为 {fields: {field:value,...}}"
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "description": "combo 场景必填,说明此次组合测试的场景(如 未达上限+异常大奖励)；单字段变异可省略"
              }
            }
          },
          "required_mock_dims": {
            "type": ["array", "null"],
            "items": {
              "enum": ["interface-call", "account-identity", "ab-experiment", "local-state"]
            },
            "description": "本 case 靠哪些 mock 维度即可自动化（需求信号，不论平台能力是否上线）。空/省略 = 无 mock 需求（happy-path 可直接自动化，或天生手工）。维度对齐 mock scenario-playbook §0；下游能力闸门比对 capability-registry.json 判可行性。填写时禁读 registry（按需求填，勿因能力未上线而省略）。"
          },
          "priority": {
            "type": "string",
            "enum": ["P0", "P1", "P2", "P3"]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "execution_mode": {
            "type": ["string", "null"],
            "enum": ["auto", "manual", null],
            "description": "执行方式：auto = 自动化执行（CI 或本地脚本），manual = 手动执行（QA 人工跑）"
          },
          "case_info": {
            "type": "object",
            "required": ["test_layer"],
            "additionalProperties": false,
            "properties": {
              "test_layer": {
                "type": "string",
                "enum": ["integration", "e2e", "stability", "unit", "component", "flow"]
              },
              "layer_rationale": {
                "type": "string"
              },
              "actor_ref": {
                "type": ["string", "null"],
                "pattern": "^(A[0-9]{3,})?$"
              },
              "flow_ref": {
                "type": ["string", "null"],
                "pattern": "^(F[0-9]{3,})?$"
              },
              "business_id": {
                "type": ["string", "null"]
              }
            }
          },
          "user_profile": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "defect_hypothesis": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "premise": {
                "type": "string"
              },
              "broken_condition": {
                "type": "string"
              },
              "expected_symptom": {
                "type": "string"
              }
            }
          },
          "pre_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "steps": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["step"],
                  "additionalProperties": false,
                  "properties": {
                    "step": {
                      "type": "string"
                    },
                    "expected": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": ["action", "target", "input"],
                  "additionalProperties": false,
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": ["call"]
                    },
                    "target": {
                      "type": "string"
                    },
                    "input": {}
                  }
                }
              ]
            }
          },
          "assertions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["desc"],
                  "additionalProperties": true,
                  "properties": {
                    "desc": {
                      "type": "string"
                    },
                    "path": {
                      "type": ["string", "null"]
                    },
                    "checkType": {
                      "type": ["string", "null"]
                    },
                    "expected": {}
                  }
                },
                {
                  "type": "object",
                  "required": ["kind", "target", "expected"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": ["output_equals"]
                    },
                    "target": {
                      "type": "string"
                    },
                    "expected": {}
                  }
                }
              ]
            }
          },
          "cleanup": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mock_intent": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "minProperties": 1,
            "description": "Phase A mock 意图(按需,happy path 不写;空占位 {} / null 不允许)。形态校验由 ucdp-e2e-v1 mini-validator 兜底,严格字段约束(trigger/assertion_dimension/network_dimension/api_dimension/data_dimension/data_shaping_dimension/account/timing/settle_strategy)由 validate_mock_intent.py 用 jsonschema against ~/.raven/skills/qa-share/mock-system/ucdp-mock-intent.schema.json 跑。完整 schema 详见 qa-share/mock-system/ucdp-mock-intent.schema.json(MVP 子集)与 ~/.raven/skills/qa-share/mock-system/ucdp-mock-intent.schema.json(canonical 全集)。详见 sdd-qa-test-case/references/mock-intent-prompt.md。"
          },
          "skip": {
            "type": "boolean"
          },
          "skip_reason": {
            "type": ["string", "null"]
          },
          "identity": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "expected_io": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "expected_value_source": {
            "type": ["string", "null"]
          },
          "_lineage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenario_ref": {
                "type": ["string", "null"],
                "pattern": "^(TS-M[0-9]{3,}-[0-9]{3,})?$"
              },
              "oracle_ref": {
                "type": ["string", "null"]
              },
              "oracle_index": {
                "type": ["integer", "null"],
                "minimum": 0
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "kb_batch": {
                      "type": ["string", "null"]
                    },
                    "query": {
                      "type": ["string", "null"]
                    }
                  }
                }
              },
              "tbd_reason": {
                "type": ["string", "null"]
              },
              "redundancy_ack": {
                "type": ["string", "null"],
                "description": "gate redundancy 硬门禁逃生口：被判 identical/subset 但合法共存时，注明为何不收敛（如公共可见性断言在多场景共享）。"
              },
              "mock_intent_skip_reason": {
                "type": ["string", "null"],
                "description": "gate mock-intent-completeness 硬门禁逃生口：标了 interface-call 但该 case 无可断言调用语义（纯读/不关心调用）时，注明跳过结论（D-MERGE3）。"
              },
              "covers": {
                "type": "array",
                "description": "本用例覆盖的需求义务 ob_id（.obligations.json）；供覆盖审计核对",
                "items": {
                  "type": "string"
                }
              },
              "spec_source_ref": {
                "type": ["object", "null"],
                "additionalProperties": true,
                "description": "D-SOURCE6: 等价类 case 必填,指向源 spec 文件 + 行号或 anchor。mock_intent 非 null 时强制必填(由 validate_mock_intent.py 校验)。",
                "properties": {
                  "spec_file": {
                    "type": "string"
                  },
                  "anchor": {
                    "type": ["string", "null"]
                  },
                  "line": {
                    "type": ["integer", "null"],
                    "minimum": 1
                  }
                }
              },
              "knowledge_refs": {
                "type": "array",
                "description": "命中的知识条目指针；必须是 object 数组，不能是字符串数组",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "properties": {
                    "source": {
                      "type": ["string", "null"]
                    },
                    "type": {
                      "type": ["string", "null"]
                    },
                    "id": {
                      "type": ["string", "null"]
                    },
                    "title": {
                      "type": ["string", "null"]
                    },
                    "query": {
                      "type": ["string", "null"]
                    },
                    "confidence": {
                      "type": ["string", "null"]
                    }
                  }
                }
              },
              "inference": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "type": ["string", "null"],
                    "enum": [
                      "kb_supported",
                      "prd_supported",
                      "model_inferred",
                      "human_confirmed",
                      null
                    ]
                  },
                  "missing_knowledge_types": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "reason": {
                    "type": "string"
                  },
                  "developer_hint": {
                    "type": "string"
                  }
                }
              },
              "code_refs": {
                "type": "array",
                "description": "D3 (sdd-qa-source-adapter): code-mining source 反查的代码实体引用. prd_ears mode 不填; code_mining mode L2/L3/L4 必填 (D7 gate 校验).",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["entity", "file", "line"],
                  "properties": {
                    "entity": {
                      "type": "string"
                    },
                    "file": {
                      "type": "string"
                    },
                    "line": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    }
                  }
                }
              },
              "rnw_tier": {
                "type": ["string", "null"],
                "enum": ["full", "core", "selective", "downgrade", null],
                "description": "D3: RNW 编译层级. code_mining mode L3 必填 (D7 gate 校验), L2/L4 可空."
              },
              "codegen_hint": {
                "type": ["object", "null"],
                "additionalProperties": false,
                "description": "D3: codegen 接口提示结构化对象. code_mining mode 全部 layer 必填 (D7 gate 校验).",
                "properties": {
                  "mock_apis": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "harness": {
                    "type": ["string", "null"],
                    "enum": ["rn-rntl", "rn-playwright", "rn-hypium", null]
                  },
                  "rnw_tier": {
                    "type": ["string", "null"],
                    "enum": ["full", "core", "selective", "downgrade", null]
                  },
                  "notes": {
                    "type": ["string", "null"]
                  }
                }
              },
              "oracle_source": {
                "type": ["string", "null"],
                "enum": ["oracle-verdicts", "render_branches", "flows", "output_contract", null],
                "description": "D3: oracle 来源标识. code_mining mode 全部 layer 必填 (D7 gate 校验)."
              },
              "enrich_fallback": {
                "type": "boolean",
                "description": "LLM enrich 失败回退标志 (code_mining source)"
              }
            }
          },
          "runtime": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "platform_case_id": {
                "type": ["string", "null"]
              },
              "executions": {
                "type": "array",
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "required": ["round", "status", "report_path"],
                  "additionalProperties": false,
                  "properties": {
                    "round": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "status": {
                      "type": "string",
                      "enum": ["passed", "failed", "skipped", "running", "timeout", "none"]
                    },
                    "duration_ms": {
                      "type": ["integer", "null"],
                      "minimum": 0
                    },
                    "started_at": {
                      "type": ["string", "null"]
                    },
                    "report_path": {
                      "type": ["string", "null"]
                    },
                    "diagnosis_ref": {
                      "type": ["string", "null"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
