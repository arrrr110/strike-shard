{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven.netease.com/schemas/qa-coverage-gate-config-v1.json",
  "title": "QA Coverage Gate Config v1",
  "type": "object",
  "required": ["schemaVersion"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L1": { "$ref": "#/definitions/threshold" },
        "L2": { "$ref": "#/definitions/threshold" },
        "L3": { "$ref": "#/definitions/threshold" },
        "L4": { "$ref": "#/definitions/threshold" }
      }
    },
    "scopeThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed": { "$ref": "#/definitions/levelThresholds" },
        "impacted": { "$ref": "#/definitions/levelThresholds" },
        "module": { "$ref": "#/definitions/levelThresholds" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxWallMs": { "type": "number", "minimum": 0 },
        "maxTotalTokens": { "type": "number", "minimum": 0 },
        "maxInterruptions": { "type": "integer", "minimum": 0 },
        "maxUnrecoveredInterruptions": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "definitions": {
    "levelThresholds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "L1": { "$ref": "#/definitions/threshold" },
        "L2": { "$ref": "#/definitions/threshold" },
        "L3": { "$ref": "#/definitions/threshold" },
        "L4": { "$ref": "#/definitions/threshold" }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lines": { "$ref": "#/definitions/pct" },
        "branches": { "$ref": "#/definitions/pct" },
        "changedLines": { "$ref": "#/definitions/pct" },
        "mutation": { "$ref": "#/definitions/pct" },
        "requirements": { "$ref": "#/definitions/pct" },
        "paths": { "$ref": "#/definitions/pct" },
        "states": { "$ref": "#/definitions/pct" },
        "contracts": { "$ref": "#/definitions/pct" },
        "faults": { "$ref": "#/definitions/pct" }
      }
    },
    "pct": { "type": "number", "minimum": 0, "maximum": 100 }
  }
}
