{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven.netease.com/schemas/qa-coverage-result-v1.json",
  "title": "QA Coverage Result v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "platform",
    "level",
    "scope",
    "commit",
    "sourceRoot",
    "denominatorId",
    "required",
    "status",
    "reasons",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "qa-coverage-result/v1" },
    "repoId": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["server", "android", "ios", "rn", "harmony"] },
    "level": { "enum": ["L1", "L2", "L3", "L4"] },
    "scope": { "enum": ["full-changed", "candidate-changed", "changed", "impacted", "module"] },
    "commit": { "type": "string", "minLength": 1 },
    "sourceRoot": { "type": "string", "minLength": 1 },
    "denominatorId": { "type": "string", "minLength": 1 },
    "required": { "type": "boolean" },
    "status": { "enum": ["PASS", "FAIL", "INVALID", "NOT_COLLECTED"] },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "codeCoverage": {
      "type": "object",
      "required": ["lines", "branches", "functions", "statements", "changedLines", "mutation"],
      "additionalProperties": false,
      "properties": {
        "lines": { "$ref": "#/definitions/countMetric" },
        "branches": { "$ref": "#/definitions/countMetric" },
        "functions": { "$ref": "#/definitions/countMetric" },
        "statements": { "$ref": "#/definitions/countMetric" },
        "changedLines": { "$ref": "#/definitions/countMetric" },
        "mutation": { "$ref": "#/definitions/countMetric" }
      }
    },
    "behaviorCoverage": {
      "type": "object",
      "required": ["requirements", "paths", "states", "contracts", "faults"],
      "additionalProperties": false,
      "properties": {
        "requirements": { "$ref": "#/definitions/setMetric" },
        "paths": { "$ref": "#/definitions/setMetric" },
        "states": { "$ref": "#/definitions/setMetric" },
        "contracts": { "$ref": "#/definitions/setMetric" },
        "faults": { "$ref": "#/definitions/setMetric" }
      }
    },
    "run": { "$ref": "qa-coverage-manifest-v1.json#/definitions/run" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "format"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "format": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "definitions": {
    "countMetric": {
      "type": "object",
      "required": ["covered", "total", "pct", "status"],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "status": { "enum": ["COLLECTED", "NOT_COLLECTED", "INVALID"] },
        "reason": { "type": "string" }
      }
    },
    "setMetric": {
      "type": "object",
      "required": [
        "covered",
        "total",
        "pct",
        "status",
        "eligible",
        "coveredIds",
        "missingIds",
        "unexpectedIds"
      ],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "number", "minimum": 0 },
        "total": { "type": "number", "minimum": 0 },
        "pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "status": { "enum": ["COLLECTED", "NOT_COLLECTED", "INVALID"] },
        "reason": { "type": "string" },
        "eligible": { "$ref": "#/definitions/idSet" },
        "coveredIds": { "$ref": "#/definitions/idSet" },
        "missingIds": { "$ref": "#/definitions/idSet" },
        "unexpectedIds": { "$ref": "#/definitions/idSet" }
      }
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
