{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdd-qa-context/v1",
  "title": "QA Context Ledger",
  "description": "Single source of truth for the SDD QA pipeline. Persisted at ravenspec/changes/<id>/qa-context.json. Only sdd-gate-verify.sh may write `gates.*.status`.",
  "type": "object",
  "required": [
    "$schema",
    "change_id",
    "platform",
    "impl_mode",
    "review_mode",
    "review_gates",
    "review_timeout",
    "review_timeout_action",
    "current_phase",
    "gates",
    "intents",
    "loop_state",
    "traceability",
    "events"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "const": "sdd-qa-context/v1" },
    "change_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "platform": { "enum": ["server", "client", "ios", "android", "all"] },
    "impl_mode": { "enum": ["internal", "external_certified", "unit_only"] },
    "external_impl": {
      "type": "object",
      "required": ["type", "ref"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["git-commit", "om-env", "repo-path"] },
        "ref": { "type": "string", "minLength": 1 },
        "checksum": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "verifier": { "type": "string" }
      }
    },
    "scope": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "rn_projects": {
      "type": "array",
      "default": [],
      "description": "本期涉及的 RN 工程，由 design skill Step 4.7 识别 + 用户确认 local_dir + node 探测后落盘。exec 阶段启动 metro 的输入。",
      "items": {
        "type": "object",
        "required": ["component", "local_dir"],
        "additionalProperties": false,
        "properties": {
          "component": { "type": "string", "description": "RN 模块名 = scoped_classes.rn_component" },
          "rn_repo": { "type": "string", "description": "RN 仓库地址 = scoped_classes.rn_repo" },
          "local_dir": { "type": "string", "description": "RN 工程源码本地绝对路径（用户确认）" },
          "node_required": { "type": "string", "description": "来自 .nvmrc/.node-version/package.json engines.node" },
          "node_actual": { "type": "string", "description": "系统 node -v" },
          "pkg_manager": { "type": "string", "description": "按 lockfile 探测：pnpm/yarn/npm" },
          "node_ok": { "type": "boolean" },
          "deps_installed": { "type": "boolean", "description": "node_modules 是否就绪" },
          "confirmed_at": { "type": "string", "format": "date-time" },
          "confirmed_by": { "type": "string" }
        }
      }
    },
    "rn_services": {
      "type": "object",
      "default": {},
      "description": "exec 阶段 metro 启动状态。key = rn_project（rn_projects[].local_dir 去重）。verify skill Step 1.9 落盘，verify_g4 前置 reachable 检查。",
      "additionalProperties": {
        "type": "object",
        "required": ["port", "reachable"],
        "additionalProperties": false,
        "properties": {
          "port": { "type": "integer" },
          "pid": { "type": "integer" },
          "reachable": { "type": "boolean" },
          "started_at": { "type": "string", "format": "date-time" },
          "probed_at": { "type": "string", "format": "date-time" }
        }
      },
      "properties": {
        "rn_env_paths": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ios": { "type": "string" },
            "android": { "type": "string" }
          }
        }
      }
    },
    "review_mode": { "enum": ["machine", "human-required"] },
    "review_gates": {
      "type": "array",
      "items": { "enum": ["G1", "G2", "G3", "G4"] },
      "uniqueItems": true,
      "default": []
    },
    "review_timeout": {
      "type": "integer",
      "minimum": 0,
      "description": "Seconds to wait for human review before fallback. Default 14400 (4h)."
    },
    "review_timeout_action": {
      "enum": ["machine", "halt"],
      "description": "On review_timeout: machine fallback or halt the pipeline."
    },
    "current_phase": {
      "enum": ["cases", "design", "codegen", "exec", "verify"],
      "description": "TDD order: cases first, then design (audit), codegen, exec."
    },
    "gates": {
      "type": "object",
      "required": ["G1_cases_ready", "G2_design_frozen", "G3_codegen_ready", "G4_tests_green"],
      "additionalProperties": false,
      "properties": {
        "G1_cases_ready":   { "$ref": "#/definitions/gate" },
        "G2_design_frozen": { "$ref": "#/definitions/gate" },
        "G3_codegen_ready": { "$ref": "#/definitions/gate" },
        "G4_tests_green":   { "$ref": "#/definitions/gate" }
      }
    },
    "intents": {
      "type": "array",
      "items": { "$ref": "#/definitions/intent" }
    },
    "loop_state": {
      "type": "object",
      "required": ["running", "tick_interval_sec"],
      "additionalProperties": false,
      "properties": {
        "running": { "type": "boolean" },
        "last_tick": { "type": "string", "format": "date-time" },
        "tick_interval_sec": { "type": "integer", "minimum": 1 },
        "started_by": { "type": "string" },
        "started_at": { "type": "string", "format": "date-time" }
      }
    },
    "next_action": {
      "type": ["string", "null"],
      "description": "Last output of qa-loop-tick.sh; observation only."
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["case", "spec_ref", "status"],
        "additionalProperties": false,
        "properties": {
          "case": { "type": "string" },
          "spec_ref": { "type": "string" },
          "tasks": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "tests": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "status": { "enum": ["covered", "uncovered", "no-task", "no-test", "external"] }
        }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/definitions/event" }
    },
    "spec_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Captured when G2_design_frozen flips to passed."
    },
    "client_project_roots": {
      "type": "object",
      "additionalProperties": false,
      "description": "客户端主工程绝对路径,由 resolve-client-main-project.sh 解析后写入。Bootstrap 与 codegen 入口都会按需写;ENV/ctx/cwd-marker/ws-config/user-prompt 任一命中即固化。",
      "properties": {
        "ios": {
          "type": "string",
          "minLength": 1,
          "description": "iOS 主工程根的绝对路径 (含 *.xcworkspace 或 *.xcodeproj 或 Podfile 或 Package.swift 任一)。"
        },
        "android": {
          "type": "string",
          "minLength": 1,
          "description": "Android 主工程根的绝对路径 (含 settings.gradle[.kts])。"
        },
        "resolved_at": {
          "type": "string",
          "format": "date-time",
          "description": "最近一次完成解析或校验的时间。"
        },
        "resolved_by": {
          "enum": ["env", "ctx", "cwd-marker", "ws-config", "user-prompt"],
          "description": "最终命中的 fallback 段。"
        }
      }
    },
    "coverage_threshold": {
      "deprecated": true,
      "description": "DEPRECATED — coverage gating removed; field ignored if present. Retained only so older qa-context.json files stay schema-valid under additionalProperties:false."
    },
    "unit_chain_step_state": {
      "type": "object",
      "additionalProperties": false,
      "description": "unit-only 链各阶段耗时台账，由 /sdd-qa-unit-only 每步实时记录。aggregate-unit-result.cjs 读 timings 计算 durations。",
      "properties": {
        "timings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["started_at", "completed_at"],
            "additionalProperties": false,
            "properties": {
              "started_at": { "type": "number", "description": "epoch ms" },
              "completed_at": { "type": "number", "description": "epoch ms" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "gate": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": true,
      "properties": {
        "status": { "enum": ["blocked", "pending", "proposed", "passed", "failed"] },
        "by": { "type": ["string", "null"] },
        "ts": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "intent": {
      "type": "object",
      "required": ["ts", "actor", "action"],
      "additionalProperties": false,
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "actor": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "pattern": "^(run-all-cases|run-cases|rerun-phase-(cases|design|codegen|exec)|skip-review-G[1-4]|reset-gate-G[1-4]|abort|await-[\\w\\u4e00-\\u9fa5-]+)$"
        },
        "reason": { "type": "string" },
        "question": { "type": "string", "description": "Full question text + options that main thread feeds to AskUserQuestion when action starts with await-" },
        "decision": { "type": "string", "description": "User's selected option, written when consumed_at is set" },
        "consumed_at": { "type": ["string", "null"], "format": "date-time" },
        "consumed_by": { "type": ["string", "null"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["ts", "actor", "event"],
      "additionalProperties": true,
      "properties": {
        "ts": { "type": "string", "format": "date-time" },
        "actor": { "type": "string" },
        "event": { "type": "string" },
        "detail": { "type": "string" }
      }
    }
  }
}
