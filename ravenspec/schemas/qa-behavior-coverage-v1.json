{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven.netease.com/schemas/qa-behavior-coverage-v1.json",
  "title": "QA L3/L4 Behavior Coverage v1",
  "type": "object",
  "required": ["schemaVersion", "eligible", "covered"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "eligible": { "$ref": "#/definitions/dimensions" },
    "covered": { "$ref": "#/definitions/dimensions" }
  },
  "definitions": {
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirements": { "$ref": "#/definitions/idSet" },
        "paths": { "$ref": "#/definitions/idSet" },
        "states": { "$ref": "#/definitions/idSet" },
        "contracts": { "$ref": "#/definitions/idSet" },
        "faults": { "$ref": "#/definitions/idSet" }
      }
    },
    "idSet": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
