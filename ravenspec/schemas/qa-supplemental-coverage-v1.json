{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raven.netease.com/schemas/qa-supplemental-coverage-v1.json",
  "title": "QA Changed and Mutation Coverage v1",
  "type": "object",
  "required": ["schemaVersion", "denominatorId"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "qa-supplemental-coverage/v1" },
    "denominatorId": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "changedLines": { "$ref": "#/definitions/count" },
    "mutation": {
      "type": "object",
      "required": ["killed", "total"],
      "additionalProperties": false,
      "properties": {
        "killed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "anyOf": [{ "required": ["changedLines"] }, { "required": ["mutation"] }],
  "definitions": {
    "count": {
      "type": "object",
      "required": ["covered", "total"],
      "additionalProperties": false,
      "properties": {
        "covered": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
