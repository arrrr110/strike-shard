# macOS 的 Finder 元数据 —— 随素材包混进来过 55 个，别让它再进仓库
.DS_Store

# Godot 4+ specific ignores
.godot/
/android/

# 本机私货：各 Agent / 编辑器工具的配置目录不进仓库。
# 换机器、换人、换 harness 都靠 AGENTS.md 重建，不靠这些目录。
# （`CLAUDE.md` 不在这个列表里 —— 它在仓库根、跟着仓库走，但只是指向 AGENTS.md 的指针。）
.agents/
.agent/
.claude/
.codex/
.cursor/
.gemini/
.trae/
.windsurf/
.qoder/
.qwen/
.opencode/
.codemaker/

# 验证探针的临时副本与时间戳（见 tools/verify.sh）
tmp/

# 风格参考图（情绪板）—— 第三方版权素材，不进仓库、不进构建。
# `reference/.gdignore` 让 Godot 不导入它们，这里让 git 不提交它们。
# 只用于看构图/配色/描边/材质，不能当游戏资产用。
reference/
reference.zip